# RECAPTCHA_SKIP=true # solo dev
# Chat OpenAI (Responses API, prompt almacenado)
OPENAI_API_KEY=
OPENAI_PROMPT_ID=pmpt_6aa92a8690c881959522b0836077156d0e8ed2595823acc7
OPENAI_PROMPT_VERSION=
# Vacío = usa la versión marcada como "default" en el dashboard (recomendado).
# Con valor (p. ej. 2) = fija esa versión. No existe el literal "default".
# Solo si la plantilla del prompt usa {{variables}}: OPENAI_PROMPT_VARIABLES='{"nombre":"valor"}'
OPENAI_PROMPT_VARIABLES=
# Variable adicional que recibe el idioma del visitante (es/en del selector web).
# El backend siempre envía también lang y datetime para el prompt publicado.
OPENAI_LANG_VAR=idioma
